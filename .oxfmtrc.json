{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"sortTailwindcss": {
		"stylesheet": "./apps/web/src/routes/layout.css"
	},
	"svelte": {},
	"ignorePatterns": [
		"package-lock.json",
		"pnpm-lock.yaml",
		"yarn.lock",
		"bun.lock",
		"bun.lockb",
		"/static/",
		"**/.svelte-kit/",
		"**/dist/",
		"packages/spektral/benchmarks/results/",
		"packages/spektral/coverage/",
		"packages/spektral/test-results/",
		"apps/web/test-results/"
	]
}
