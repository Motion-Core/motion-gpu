{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spektral",
	"compatibility_date": "2025-09-27",
	"vars": {
		"PUBLIC_PLAYGROUND_PREVIEW_ORIGIN": "https://preview.spektral.dev",
		"PLAYGROUND_PREVIEW_PARENT_ORIGINS": "https://spektral.dev,https://www.spektral.dev"
	},
	"observability": {
		"enabled": true
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "spektral.dev/*",
			"zone_name": "spektral.dev"
		},
		{
			"pattern": "www.spektral.dev/*",
			"zone_name": "spektral.dev"
		},
		{
			"pattern": "preview.spektral.dev/*",
			"zone_name": "spektral.dev"
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.ttf"],
			"fallthrough": true
		}
	],
	"compatibility_flags": ["nodejs_compat"]
}
